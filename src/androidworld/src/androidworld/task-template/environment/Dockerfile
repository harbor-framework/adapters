# AndroidWorld task image. Needs linux/amd64 and (strongly) KVM on the host:
# the Android emulator is x86_64 and is unusably slow without hardware acceleration.
FROM --platform=linux/amd64 python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl wget unzip bzip2 git procps util-linux ca-certificates openjdk-17-jre-headless \
    libdrm-dev libxkbcommon-dev libgbm-dev libasound-dev libnss3 libxcursor1 libpulse-dev \
    libxshmfence-dev xauth xvfb ffmpeg build-essential \
    && rm -rf /var/lib/apt/lists/*

# Android SDK + Pixel 6 / API 33 (google_apis, x86_64) AVD, as in AndroidWorld's Dockerfile.
ENV ANDROID_HOME=/opt/android
ENV ANDROID_SDK_ROOT=/opt/android
ENV PATH="$PATH:${ANDROID_HOME}/cmdline-tools/tools/bin:${ANDROID_HOME}/emulator:${ANDROID_HOME}/platform-tools:${ANDROID_HOME}/build-tools/33.0.0"
ENV EMULATOR_NAME=AndroidWorldAvd
RUN wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -P /tmp \
    && unzip -q -d "${ANDROID_HOME}" /tmp/commandlinetools-linux-11076708_latest.zip \
    && mkdir -p "${ANDROID_HOME}/cmdline-tools/tools" \
    && cd "${ANDROID_HOME}/cmdline-tools" && mv NOTICE.txt source.properties bin lib tools/ \
    && rm /tmp/*.zip
RUN yes | sdkmanager --licenses >/dev/null \
    && sdkmanager --no_https "system-images;android-33;google_apis;x86_64" "platforms;android-33" \
       "build-tools;33.0.0" platform-tools emulator
RUN echo "no" | avdmanager create avd --force --name AndroidWorldAvd --device pixel_6 \
    --package "system-images;android-33;google_apis;x86_64" \
    && sed -i 's/^hw\.keyboard = no$/hw.keyboard = yes/' /root/.android/avd/AndroidWorldAvd.avd/config.ini \
    && grep -q '^hw\.keyboard = yes$' /root/.android/avd/AndroidWorldAvd.avd/config.ini

ENV GRPC_VERBOSITY=ERROR GRPC_ENABLE_FORK_SUPPORT=0 GLOG_minloglevel=2

# AndroidWorld (pinned commit; protos are generated by its setup.py).
RUN git clone https://github.com/google-research/android_world.git /opt/android_world \
    && cd /opt/android_world && git checkout 55ddaf5edc6f6c25673aed343907d5b9dca66f84 \
    && pip install --no-cache-dir . Pillow==10.4.0 websocket-client==1.8.0

COPY aw/ /opt/aw/
COPY task_spec.json /opt/aw/task_spec.json
RUN chmod +x /opt/aw/*.sh && mkdir -p /workspace /logs
WORKDIR /workspace
ENTRYPOINT ["/opt/aw/entrypoint.sh"]
CMD ["sleep", "infinity"]
