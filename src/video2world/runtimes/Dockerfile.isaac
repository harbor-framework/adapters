# syntax=docker/dockerfile:1
FROM nvcr.io/nvidia/isaac-sim@sha256:93b0f99635ab126fb5b33298d513c11520f119f0ee60ff8414ccef67ea977829
USER root
SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]
ENV TERM=xterm-256color DEBIAN_FRONTEND=noninteractive ACCEPT_EULA=Y OMNI_KIT_ACCEPT_EULA=YES OMNI_KIT_ALLOW_ROOT=1 NVIDIA_DRIVER_CAPABILITIES=all PYTHONNOUSERSITE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git ffmpeg libxt6 libgl1 libegl1 libglib2.0-0 libvulkan1 vulkan-tools \
    && rm -rf /var/lib/apt/lists/*

COPY constraints-isaac.txt /opt/v2w-deps/constraints.txt
RUN printf 'pip==24.3.1 --hash=sha256:3790624780082365f47549d032f3770eeb2b1e8bd1f7b2e02dace1afa361b4ed\n' > /tmp/pip-bootstrap.txt \
    && /isaac-sim/python.sh -m pip install --no-input --no-cache-dir --no-deps --require-hashes \
    --target /opt/v2w-pip -r /tmp/pip-bootstrap.txt
ENV PYTHONPATH=/opt/v2w-pip PIP_CONSTRAINT=/opt/v2w-deps/constraints.txt

COPY IsaacLab /opt/IsaacLab
RUN test -x /isaac-sim/python.sh && ln -s /isaac-sim /opt/IsaacLab/_isaac_sim
RUN /isaac-sim/python.sh -m pip install --no-input --no-cache-dir \
    toml fastapi numpy packaging typing_extensions filelock websockets scipy warp-lang \
    opencv-python-headless 'imageio[ffmpeg]' trimesh rtree h5py shapely omegaconf transforms3d PyYAML
RUN cd /opt/IsaacLab && ./isaaclab.sh --install none
RUN /isaac-sim/python.sh - <<'PYTHON'
from pathlib import Path
config = Path('/isaac-sim/exts/omni.pip.compute/config/extension.toml')
text = config.read_text()
stanza = '[[python.module]]\npath = "pip_prebundle/cv2"\n'
assert text.count(stanza) == 1, f'Expected one cv2 search-root registration in {config}'
assert '[[python.module]]\npath = "pip_prebundle"\n' in text, f'Missing parent pip_prebundle registration in {config}'
config.write_text(text.replace(stanza, '[[python.module]]\nname = "cv2"\npath = "pip_prebundle/cv2"\n'))
PYTHON

ENV VK_ICD_FILENAMES=/etc/vulkan/icd.d/nvidia_icd.json VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json V2W_FFMPEG=/usr/bin/ffmpeg
WORKDIR /opt/video2world
ENTRYPOINT []
