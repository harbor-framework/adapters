# A separate Python environment, as required upstream (NumPy 1.26 vs 2.4).
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg libgl1 libegl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY requirements-twin.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir -r /tmp/requirements.txt
