# Copy to .env.local (ignored by Git). Never put secrets in settings JSON or logs.
# Use the key provisioned for this experiment by the Harbor Index team.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://app.ppapi.ai/v1
# Required for approved Daytona runs. Export this into the launching process;
# --env-file currently reads only OPENAI_API_KEY, not the Daytona SDK credential.
DAYTONA_API_KEY=
# Only needed for publishing result artifacts; not used by model inference.
HF_TOKEN=
